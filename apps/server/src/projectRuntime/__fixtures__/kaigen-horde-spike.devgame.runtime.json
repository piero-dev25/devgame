{
  "version": 1,
  "profiles": [
    {
      "id": "vfx-arena",
      "name": "VFX arena (existing debug build)",
      "executable": "Runtime/out/macos/debug/kaigen-horde-spike",
      "cwd": "Runtime",
      "args": ["--vfx"],
      "outputs": []
    },
    {
      "id": "vfx-capture-fire-front-0.65",
      "name": "Capture fire front at 0.65 s (no build, 2 s startup settle)",
      "executable": "Runtime/out/macos/debug/kaigen-horde-spike",
      "cwd": "Runtime",
      "args": [
        "--vfx",
        "--commands",
        "2.30:key_down:1;2.36:key_up:1;2.40:key_down:Space;2.46:key_up:Space;2.47:key_down:Z;2.49:key_up:Z;2.50:vfx_capture_hold:0.65;2.55:key_down:R;2.61:key_up:R;3.5500:vfx_capture_probe;3.6500:screenshot:{{runDir}}/fire-front-t00_65.png:full;4.4500:quit"
      ],
      "outputs": [
        {
          "name": "capture",
          "kind": "image",
          "path": "{{runDir}}/fire-front-t00_65.png"
        }
      ],
      "evidence": {
        "logPatterns": ["VFX capture probe:.*effect age 0\\.65(,|$)", "screenshot saved:"],
        "build": "Runtime/out/macos/debug/kaigen-horde-spike"
      }
    },
    {
      "id": "capture-fire-front-0.65",
      "name": "CAPTURE: fire front at 0.65 s (capture_kaigen_vfx.sh, no build)",
      "executable": "tools/capture_kaigen_vfx.sh",
      "args": ["1", "front", "0.65", "{{runDir}}/fire-front-t00_65.png", "--no-build"],
      "outputs": [
        { "name": "capture", "kind": "image", "path": "{{runDir}}/fire-front-t00_65.png" },
        { "name": "game-log", "kind": "log", "path": "{{runDir}}/fire-front-t00_65.log" }
      ],
      "evidence": {
        "logPatterns": ["VFX capture probe:.*effect age 0\\.65(,|$)", "screenshot saved:"],
        "build": "Runtime/out/macos/debug/kaigen-horde-spike"
      }
    }
  ]
}
