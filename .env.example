# Optional: T3 Connect source builds
# Leave these unset to disable optional T3 Connect features in local source builds.
# Release builds inject their public values at build time. Do not add server-side
# secrets to this file.

# Get these from the Clerk Dashboard under API keys, JWT templates, and OAuth applications.
# T3CODE_CLERK_PUBLISHABLE_KEY=pk_test_...
# T3CODE_CLERK_JWT_TEMPLATE=t3-relay
# T3CODE_CLERK_CLI_OAUTH_CLIENT_ID=oauthapp_...

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in T3CODE_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# T3CODE_APPLE_TEAM_ID=ABC1234567
# T3CODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/t3code.provisionprofile
# T3CODE_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Get this from your relay deployment. `infra/relay` deploys update it automatically.
# T3CODE_RELAY_URL=https://relay.example.com

# Hosted app origin used by the CLI's out-of-band OAuth flow and by the web
# bundle to recognise the hosted deployment. No default: unset means there is no
# hosted app, and the out-of-band flow reports a configuration error.
# T3CODE_HOSTED_APP_URL=https://app.example.com

# Hosted web deployment domains used by the release workflow's aliasing step and
# by the Vercel channel router. No defaults: unset omits the router rules.
# T3CODE_WEB_ROUTER_URL=https://app.example.com
# T3CODE_WEB_LATEST_DOMAIN=latest.app.example.com
# T3CODE_WEB_NIGHTLY_DOMAIN=nightly.app.example.com

# Optional: releases page the desktop update toast links to. Falls back to the
# repository a CI build runs in (GITHUB_REPOSITORY); with neither, no link shows.
# VITE_DESKTOP_RELEASE_TAG_URL=https://github.com/example/app/releases/tag

# Mobile build identity. No defaults: unset disables OTA updates, omits the EAS
# owner/project, leaves code signing to Xcode, and ships no passkey entitlement.
# T3CODE_EAS_OWNER=example-org
# T3CODE_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
# T3CODE_EAS_UPDATE_URL=https://u.expo.dev/00000000-0000-0000-0000-000000000000
# T3CODE_PASSKEY_RELYING_PARTY=clerk.example.com

# Optional: anonymous product telemetry. Both are required to send anything;
# with either unset the app transmits nothing.
# T3CODE_TELEMETRY_ENABLED=true
# T3CODE_POSTHOG_KEY=phc_...

# Optional: marketing site links and figures. No defaults — an unset value is
# rendered as absent rather than as another project's.
# PUBLIC_GITHUB_REPOSITORY_URL=https://github.com/example/app
# PUBLIC_IOS_APP_STORE_URL=https://apps.apple.com/us/app/example/id000000000
# PUBLIC_ANDROID_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.example.app
# PUBLIC_MARKETING_GITHUB_STARS=1k+
# PUBLIC_MARKETING_USERS=10,000

# Public, ingest-only mobile OpenTelemetry configuration.
# T3CODE_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# T3CODE_MOBILE_OTLP_TRACES_DATASET=t3-code-mobile-traces-dev
# T3CODE_MOBILE_OTLP_TRACES_TOKEN=xaat-...
